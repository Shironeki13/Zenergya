rules_version = '2';

// Le navigateur n'accède pas directement au stockage.
// - Pièces justificatives des contrats : déposées par le serveur (/api/pieces), qui contrôle la session et le périmètre
//   de l'utilisateur ; consultées par leur adresse de téléchargement à jeton, que le serveur ne communique qu'avec les
//   documents du périmètre de l'utilisateur.
// - Archives légales des factures et avoirs : écrites et lues par le serveur ; téléchargement via /api/documents/…
// Le serveur (Admin SDK) n'est pas soumis à ces règles.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
