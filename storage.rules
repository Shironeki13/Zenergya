rules_version = '2';

// Documents (contrats PDF, logos…) réservés aux utilisateurs autorisés de l'application.
// Voir firestore.rules pour la signification des claims.
service firebase.storage {
  match /b/{bucket}/o {
    function isAppUser() {
      return request.auth != null && request.auth.token.zen == true;
    }

    // Archives légales des factures et avoirs : écrites et lues uniquement par le serveur (Admin SDK),
    // jamais modifiables depuis le navigateur. Téléchargement via /api/documents/… après contrôle de session.
    // Les règles s'additionnant (OU logique), le dossier « archives » est exclu de la règle générale.
    match /{folder}/{allPaths=**} {
      allow read, write: if folder != 'archives' && isAppUser();
    }
  }
}
