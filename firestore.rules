rules_version = '2';

// Le navigateur n'accède directement qu'aux RÉFÉRENTIELS. Tout le reste — clients, contrats, sites, prestations,
// compteurs, relevés, factures, avoirs, contacts, documents de contrat, devis, affaires, commandes, heures,
// paramétrage P1… — est lu et écrit par le serveur (Admin SDK, non soumis à ces règles), qui applique le périmètre
// de l'utilisateur (sociétés, agences, secteurs) : voir docs/perimetre.md.
//
// Les droits sont portés par des custom claims Firebase posés par le serveur (/api/auth/session) :
//   zen   = compte présent dans la collection `users` (ou dans ADMIN_EMAILS)
//   admin = rôle marqué « Administrateur » (ou ADMIN_EMAILS)
//   param = module « Paramétrage et imports » (ou administrateur)
service cloud.firestore {
  match /databases/{database}/documents {

    function isAppUser() {
      return request.auth != null && request.auth.token.zen == true;
    }

    function isAdmin() {
      return isAppUser() && request.auth.token.admin == true;
    }

    // Module Paramétrage : écriture des référentiels.
    function isParam() {
      return isAppUser() && (request.auth.token.admin == true || request.auth.token.param == true);
    }

    // Référentiels : lisibles par tous les utilisateurs (leurs libellés servent partout), modifiables avec le module
    // Paramétrage.
    function isReferentiel(coll) {
      return coll in ['companies', 'agencies', 'sectors', 'activities', 'schedules', 'terms', 'typologies', 'vatRates',
        'revisionFormulas', 'revisionRules', 'paymentTerms', 'pricingRules', 'markets', 'meterTypes', 'weatherStations',
        'djus', 'djuMonthly', 'indices', 'indexValues', 'settlement_rules'];
    }

    // Bibliothèque de prix (articles, ouvrages) et compteurs de numérotation qu'elle utilise : utilisateurs de
    // l'application.
    function isBibliotheque(coll) {
      return coll in ['priceArticles', 'priceWorks', 'config'];
    }

    // Les règles qui correspondent à un même chemin s'additionnent (OU logique) : une seule règle, en liste blanche.
    // Toute collection qui n'y figure pas est refusée, en lecture comme en écriture.
    match /{coll}/{docId} {
      allow read: if isAppUser() && (isReferentiel(coll) || isBibliotheque(coll) || coll in ['users', 'roles'])
        || (isAdmin() && coll == 'imports');
      allow create, update, delete: if (isReferentiel(coll) && isParam())
        || (isBibliotheque(coll) && isAppUser())
        || (coll in ['users', 'roles'] && isAdmin());
    }

    // Aucune sous-collection n'est utilisée : tout le reste est refusé par défaut.
  }
}
