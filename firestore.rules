rules_version = '2';

// Accès réservé aux utilisateurs autorisés de l'application.
// Les droits sont portés par des custom claims Firebase posés par le serveur (/api/auth/session) :
//   zen   = compte présent dans la collection `users` (ou dans ADMIN_EMAILS)
//   admin = rôle marqué « Administrateur » (ou ADMIN_EMAILS)
// Le serveur (Admin SDK) n'est pas soumis à ces règles.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAppUser() {
      return request.auth != null && request.auth.token.zen == true;
    }

    function isAdmin() {
      return isAppUser() && request.auth.token.admin == true;
    }

    // Collections modifiables uniquement par un administrateur.
    function isAdminOnly(coll) {
      return coll in ['users', 'roles'];
    }

    // Documents comptables : écrits uniquement par le serveur (Admin SDK), qui attribue les numéros
    // dans la même transaction. Côté navigateur, seules les exceptions ci-dessous sont permises.
    function isAccounting(coll) {
      return coll in ['invoices', 'creditNotes', 'counters'];
    }

    // Attention : les règles qui correspondent à un même chemin s'additionnent (OU logique),
    // d'où une règle générique qui exclut explicitement les collections traitées à part.
    match /{coll}/{docId} {
      allow read: if isAppUser();
      allow create, update, delete: if !isAccounting(coll) && (isAdmin() || (isAppUser() && !isAdminOnly(coll)));
    }

    match /invoices/{invoiceId} {
      // Suivi des encaissements : seul le statut d'une facture émise et non annulée peut changer, entre ces valeurs.
      allow update: if isAppUser()
        && resource.data.status in ['due', 'overdue', 'paid']
        && request.resource.data.status in ['due', 'overdue', 'paid']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      // Un proforma (sans numéro) peut être supprimé ; une facture émise s'annule par un avoir.
      allow delete: if isAppUser() && resource.data.status == 'proforma';
    }

    // Aucune sous-collection n'est utilisée : tout le reste est refusé par défaut.
  }
}
